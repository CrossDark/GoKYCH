{
  // Cloudflare Workers 配置文件（用于 @opennextjs/cloudflare 部署）
  // 腾讯云 EdgeOne Makers 部署会忽略此文件，使用平台内置适配器。
  //
  // ─── Worker 名称 ────────────────────────────────────────
  // name 和 WORKER_SELF_REFERENCE.service 必须完全一致（两者都指同一个 Worker），
  // 否则会出现 10143 错误。如需自定义 Worker 名称，同时修改下面两个字段：
  //
  //   "name": "your-custom-name",
  //   "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "your-custom-name" }]
  //
  // ─── 构建环境变量 ────────────────────────────────────────
  // NEXT_PUBLIC_API_BASE_URL 是 Next.js 构建时变量，不要写在此文件中，
  // 通过以下方式设置：
  //   CLI 部署：web/.env.local 或 shell 环境变量
  //   Dashboard 部署：Builds → Environment variables
  //
  // ─── 部署命令 ───────────────────────────────────────────
  //   npm install         # 首次安装依赖
  //   npx wrangler login  # CLI 方式：首次登录 Cloudflare
  //   npm run cf:build    # 构建（仅构建，不部署）
  //   npm run cf:deploy   # 部署到 Cloudflare（需先构建）
  //   npm run cf:preview  # 本地预览 Workers 运行时

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gokych",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gokych"
    }
  ],

  "observability": {
    "enabled": true
  }
}
