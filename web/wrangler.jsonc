{
  // Cloudflare Workers 配置文件（用于 @opennextjs/cloudflare 部署）
  // 腾讯云 EdgeOne Makers 部署会忽略此文件，使用平台内置适配器。
  //
  // ─── Worker 名称配置 ────────────────────────────────────
  // 通过 WORKER_NAME 环境变量指定 Worker 名称，name 和 WORKER_SELF_REFERENCE
  // 自动同步，不会出现 10143 错误。用法：
  //
  //   WORKER_NAME=created-rule-front npm run deploy
  //
  // 不设置则默认使用 "gokych"。
  //
  // ─── NEXT_PUBLIC_API_BASE_URL ───────────────────────────
  // 这是 Next.js 构建时环境变量（会被内联到客户端 bundle），必须在
  // 构建阶段通过 .env.local 或 shell 环境变量传入。
  // 不要使用 wrangler secret put 设置 NEXT_PUBLIC_* 变量（构建时不读取）。
  //
  // ─── 部署命令 ───────────────────────────────────────────
  //   npm install         # 首次安装依赖
  //   npx wrangler login  # 首次登录 Cloudflare
  //   npm run deploy      # 构建 + 部署到 Cloudflare Workers
  //   npm run preview     # 本地预览 Workers 运行时
  //   npm run dev         # 本地开发（Next.js dev server）

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "${WORKER_NAME:-gokych}",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "${WORKER_NAME:-gokych}"
    }
  ],

  "observability": {
    "enabled": true
  }
}
