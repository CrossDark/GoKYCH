# ── GoKYCH 环境变量 ────────────────────────────────────────
# 复制为 .env 并根据需要修改

# ── 数据库 ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=gokych
DB_PASSWORD=gokych
DB_NAME=gokych
DB_CHARSET=utf8mb4
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── 应用 ──
APP_PORT=8000
GIN_MODE=debug

# ── WebAuthn / Passkey ──
# 启用 Passkey 登录所需的依赖域名。开发场景一般是 Next.js dev server 的
# 地址（http://localhost:3000）；空则禁用 Passkey，登录页会显示
# "Passkey 未配置。"。生产改成前端实际域名，如 `https://eo.kych.net`。
APP_DOMAIN=localhost:3000

# ── 跨域（CORS + 绝对资源 URL）──
# PUBLIC_URL：后端对外可访问的绝对基础 URL，拼接在 /uploads/* 等相对
# 路径前面，让前端（EdgeOne / 独立域名）能直接拿到图片。
# 生产场景如 `https://api.kych.net`。
# CORS_ALLOWED_ORIGINS：允许跨域 fetch 的 origin 列表，逗号分隔，
# 必须带 scheme。带 cookie 的话不能用通配符，必须显式列。
# 开发场景一般是 http://localhost:3000；生产就是你前端实际域名，
# 如 `https://eo.kych.net`。
# 当 eo.kych.net 的 nginx 同 origin 转发 /api/* 时实际用不到 CORS，
# 但留着兼容 dev / 跨域备用路径，零成本。
# PUBLIC_URL=https://api.kych.net
# CORS_ALLOWED_ORIGINS=https://eo.kych.net

# ── 信任代理（反向代理 IP 透传）──
# nginx 在 127.0.0.1 时设 127.0.0.1，让 c.ClientIP() 从 X-Forwarded-For
# 取真实 IP 而不被伪造绕开限流。
# TRUSTED_PROXIES=127.0.0.1

# ── 会话 ──
# 会话密钥 (生产环境务必修改为随机字符串)
# `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-random-string

# SESSION_COOKIE_DOMAIN：把 session cookie 绑到父域(必须带前导点 . )，
# 让前端(eo.kych.net)和后端(api.kych.net)都能看到。前端 SSR 的
# cookies() 才能拿到 session 转发给后端，后端 CurrentUser 才不会把
# 登录用户当成匿名 —— 否则 rating 滑块会停在 0.0。
#
# 单主机部署(API 和前端同 origin)留空；跨子域部署(生产布局)必设。
# 例子：生产 .kych.net；本地 dev 留空。
# SESSION_COOKIE_DOMAIN=.kych.net

# ── 默认管理员 ──
# 仅在 users 表为空时创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── 数据目录 ──
DATA_DIR=data