# ── GoKYCH 环境变量 ────────────────────────────────────────
# 复制为 .env 并根据需要修改

# ── 数据库 ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=gokych
DB_PASSWORD=gokych
DB_NAME=gokych
DB_CHARSET=utf8mb4
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── 应用 ──
APP_PORT=8000
GIN_MODE=debug

# ── WebAuthn / Passkey ──
# 启用 Passkey 登录所需的依赖域名。开发场景一般是 Next.js dev server 的
# 地址（http://localhost:3000）；空则禁用 Passkey，登录页会显示
# "Passkey 未配置。"。生产请改成真实域名，如 `https://example.com`。
APP_DOMAIN=localhost:3000

# ── 会话 ──
# 会话密钥 (生产环境务必修改为随机字符串)
SESSION_SECRET=change-me-to-a-random-string

# ── 默认管理员 ──
# 仅在 users 表为空时创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── 数据目录 ──
DATA_DIR=data
