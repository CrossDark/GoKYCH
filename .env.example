# ── GoKYCH 环境变量 ────────────────────────────────────────
# 复制为 .env 并根据需要修改

# ── 数据库 ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=gokych
DB_PASSWORD=gokych
DB_NAME=gokych
DB_CHARSET=utf8mb4
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── 应用 ──
APP_PORT=8000
GIN_MODE=debug

# ── WebAuthn / Passkey ──
# 启用 Passkey 登录所需的依赖域名。开发场景一般是 Next.js dev server 的
# 地址（http://localhost:3000）；空则禁用 Passkey，登录页会显示
# "Passkey 未配置。"。生产请改成真实域名，如 `https://example.com`。
APP_DOMAIN=localhost:3000

# ── 跨域（CORS + 绝对资源 URL）──
# PUBLIC_URL：后端对外可访问的绝对基础 URL，拼接在 /uploads/* 等相对
# 路径前面，让跨域前端（Cloudflare Pages）能直接拿到图片。开发场景
# 留空即可（Next.js dev 的 /uploads/* rewrite 兜底）。
# CORS_ALLOWED_ORIGINS：允许跨域 fetch 的 origin 列表，逗号分隔，
# 必须带 scheme。带 cookie 的话不能用通配符，所以这里必须显式列。
# 开发场景一般是 http://localhost:3000；生产就是你前端实际域名。
# PUBLIC_URL=
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── 会话 ──
# 会话密钥 (生产环境务必修改为随机字符串)
SESSION_SECRET=change-me-to-a-random-string

# ── 默认管理员 ──
# 仅在 users 表为空时创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── 数据目录 ──
DATA_DIR=data
